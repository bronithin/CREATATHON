# ==============================================================================
# Creatathon 2026 - Server-Side Environment Variables (.env / .env.local)
# DO NOT COMMIT REAL SECRETS OR VALUES TO VERSION CONTROL
# ==============================================================================

# 1. Google Sheets Webhook Configuration (Server-Side Only)
GOOGLE_SHEET_URL=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WEBHOOK_URL=

# 2. Google Apps Script Shared Secret Authentication (Matches Script Properties WEBHOOK_SECRET)
GOOGLE_SHEET_WEBHOOK_SECRET=

# 3. Admin Notification Email (Configured in Google Apps Script properties ADMIN_EMAIL)
ADMIN_MAIL=

# 4. Optional: Distributed Rate Limiting via Upstash Redis (For Serverless deployments)
# If omitted, system seamlessly falls back to resilient in-memory sliding-window limiter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

